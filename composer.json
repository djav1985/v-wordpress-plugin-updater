{
  "require-dev": {
    "squizlabs/php_codesniffer": "^3.13.6",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.2.1",
    "wp-coding-standards/wpcs": "^3.4.1",
    "phpstan/phpstan": "^2.3.5",
    "php-stubs/wp-cli-stubs": "^2",
    "szepeviktor/phpstan-wordpress": "^2.0.4",
    "php-stubs/wordpress-stubs": "^6.9.4",
    "phpstan/extension-installer": "^1.4",
    "phpunit/phpunit": "^11.5.58"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    }
  },
  "scripts": {
    "phpcs": "phpcs --standard=phpcs.xml --extensions=php v-wp-updater/ v-update-api/",
    "phpcbf": "phpcbf --standard=phpcs.xml --extensions=php v-wp-updater/ v-update-api/",
    "phpstan": "phpstan analyse --no-progress --memory-limit=1G",
    "test": "phpunit"
  }
}
