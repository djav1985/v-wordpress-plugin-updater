includes:
  - phpstan-baseline.neon

parameters:
  tmpDir: .phpstan-cache
  level: 6
  paths:
    - v-wp-updater
    - v-update-api
  excludePaths:
    - v-wp-updater/vendor
    - v-wp-updater/vendor/*
    - v-update-api/vendor
    - v-update-api/vendor/*
  bootstrapFiles:
    - .github/phpstan-bootstrap.php
    - v-update-api/vendor/autoload.php
